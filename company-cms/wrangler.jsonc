{
  // Company portfolio + admin dashboard — Cloudflare Worker + D1 + R2
  "name": "company-cms",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "company", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [ { "binding": "MEDIA", "bucket_name": "company-media" } ],
  "observability": { "enabled": true }
  // Secrets (npx wrangler secret put NAME):
  //   ADMIN_PASSWORD      — password of the first admin user ("admin")
  //   ANTHROPIC_API_KEY   — optional, for "import from company profile"
  //   TELEGRAM_BOT_TOKEN  — optional, instant alerts when a tracked link is opened / a request arrives
  //   TELEGRAM_CHAT_ID    — optional, the chat that receives the alerts
}
