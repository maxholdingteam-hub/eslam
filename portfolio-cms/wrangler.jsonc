{
  // Portfolio CMS — Cloudflare Worker + D1 (database) + R2 (images) + static assets
  "name": "portfolio-cms",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "portfolio", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "portfolio-media" }
  ],
  "observability": { "enabled": true }
  // Secrets (set with `npx wrangler secret put NAME`):
  //   ADMIN_PASSWORD     — password for /admin
  //   ANTHROPIC_API_KEY  — for "import from CV"
}
